# .env.example
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.
# For production (Railway / Render), set these as environment variables in the hosting dashboard.

# ── Database ────────────────────────────────────────────────────────────────
ConnectionStrings__Default=Host=localhost;Database=myapp;Username=postgres;Password=postgres

# ── First admin account (used by Data/SeedAdmin.cs on first startup) ────────
SEED_ADMIN_EMAIL=you@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME

# ── Stripe (uncomment if using Stripe.net) ──────────────────────────────────
# STRIPE_SECRET_KEY=CHANGE_ME
# STRIPE_WEBHOOK_SECRET=CHANGE_ME

# ── Cloudflare R2 file storage (uncomment if using R2) ──────────────────────
# R2_ACCOUNT_ID=CHANGE_ME
# R2_ACCESS_KEY_ID=CHANGE_ME
# R2_SECRET_ACCESS_KEY=CHANGE_ME
# R2_BUCKET_NAME=CHANGE_ME
# R2_PUBLIC_URL=CHANGE_ME

# ── Cloudinary file storage (uncomment if using Cloudinary) ─────────────────
# CLOUDINARY_CLOUD_NAME=CHANGE_ME
# CLOUDINARY_API_KEY=CHANGE_ME
# CLOUDINARY_API_SECRET=CHANGE_ME

# ── AWS S3 file storage (uncomment if using S3) ─────────────────────────────
# AWS_ACCESS_KEY_ID=CHANGE_ME
# AWS_SECRET_ACCESS_KEY=CHANGE_ME
# AWS_REGION=CHANGE_ME
# AWS_BUCKET_NAME=CHANGE_ME

# ── Azure Blob Storage (uncomment if using Azure) ───────────────────────────
# AZURE_STORAGE_CONNECTION_STRING=CHANGE_ME
# AZURE_STORAGE_CONTAINER=uploads

# ── Email (uncomment the service you're using) ──────────────────────────────
# SENDGRID_API_KEY=CHANGE_ME
# RESEND_API_KEY=CHANGE_ME

# ── Other third-party keys ───────────────────────────────────────────────────
# Add any additional API keys here. Never put them in source files or front-end code.
